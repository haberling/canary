<Project>

  <!--
    One shared version for the whole repo. Canary.csproj's publish and the
    MSI's ProductVersion (installer/Package.wxs) both read this, so the exe
    and its installer can never drift apart. Alpha, per README.md.
  -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
  </PropertyGroup>

</Project>
